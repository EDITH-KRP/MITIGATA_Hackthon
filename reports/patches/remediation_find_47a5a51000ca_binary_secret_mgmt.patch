+"""secret_access.py - fail-closed secret loading (better path: vault).
+
+Generated by CyberForge CART RemediationAdvisor for
+confirmed `binary_hardcoded_credential` findings. Never compile
+secrets into binaries; load from environment, or a secret manager /
+key vault (HashiCorp Vault, AWS Secrets Manager, Azure Key Vault).
+"""
+import os
+
+class MissingSecretError(RuntimeError):
+    pass
+
+
+def get_secret(name: str) -> str:
+    """Read a secret from the environment or fail closed.
+
+    Preferred production path (commented): short-lived lease from a
+    vault instead of a long-lived environment variable.
+    """
+    value = os.environ.get(name)
+    if not value:
+        raise MissingSecretError(
+            f'Required secret {name!r} is not configured; refusing to start.'
+        )
+    return value
+
+
