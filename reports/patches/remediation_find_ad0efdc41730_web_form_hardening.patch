+"""hardened_login.py - CSRF, validation and parameterised SQL demo.
+
+Generated by CyberForge CART RemediationAdvisor for
+confirmed `web_form_endpoint` findings. Wire into your Flask app
+and replace the vulnerable route auth with these primitives.
+"""
+import os
+import re
+import secrets
+import sqlite3
+
+from flask import abort, request, session
+
+_USERNAME_RE = re.compile(r'^[a-zA-Z0-9_.-]{3,32}$')
+
+
+def issue_csrf_token() -> str:
+    """Per-session CSRF token; render into every form template."""
+    token = session.get('csrf_token')
+    if not token:
+        token = secrets.token_urlsafe(32)
+        session['csrf_token'] = token
+    return token
+
+
+def require_csrf() -> None:
+    """Reject forms without a matching token (fail closed)."""
+    if request.form.get('csrf_token', '') != session.get('csrf_token'):
+        abort(403)
+
+
+def validate_username(username: str) -> str:
+    """Strict allow-list validation before any use."""
+    if not _USERNAME_RE.fullmatch(username or ''):
+        abort(400)
+    return username
+
+
+def fetch_user(db_path: str, username: str):
+    """Parameterised query - user input never becomes SQL text."""
+    with sqlite3.connect(db_path) as conn:
+        return conn.execute(
+            'SELECT id, username, pw_hash FROM users WHERE username = ?',
+            (username,),
+        ).fetchone()
