+/* safe_io.h - bounded replacements for dangerous libc functions.
+ * Generated by CyberForge CART RemediationAdvisor.
+ * Confirmed unsafe usages: popen.
+ * Include after <stdio.h> / <string.h>; link once per binary.
+ */
+#ifndef CART_SAFE_IO_H
+#define CART_SAFE_IO_H
+
+#include <stdio.h>
+#include <string.h>
+
+/* Bounded copy: never overflows dst, always NUL-terminates. */
+static inline void safe_strcpy(char *dst, size_t dstsize, const char *src) {
+    if (!dst || dstsize == 0) return;
+    snprintf(dst, dstsize, "%s", src ? src : "");
+}
+
+/* Bounded line input: replaces gets()/strcpy-from-stdin. */
+static inline int safe_gets(char *dst, size_t dstsize) {
+    if (!dst || dstsize == 0) return -1;
+    if (fgets(dst, (int)dstsize, stdin) == NULL) return -1;
+    dst[strcspn(dst, "\n")] = '\0';
+    return 0;
+}
+
+/* Bounded formatting: replaces sprintf(). */
+#define safe_sprintf(dst, dstsize, ...) snprintf((dst), (dstsize), __VA_ARGS__)
+
+/* Bounded concatenation: replaces strcat(). */
+static inline void safe_strcat(char *dst, size_t dstsize, const char *src) {
+    if (!dst || dstsize == 0) return;
+    size_t used = strnlen(dst, dstsize);
+    if (used < dstsize) snprintf(dst + used, dstsize - used, "%s", src ? src : "");
+}
+
+/* No shell: allow-list then execv() — replaces system()/popen(). */
+int safe_exec_allowed(const char *cmd, char *const argv[]);
+
+#endif /* CART_SAFE_IO_H */
